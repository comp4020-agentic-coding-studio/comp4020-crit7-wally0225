---
import { listCourses, listTakenCourseIds } from "../lib/db";
import "../styles.css";

const courses = listCourses();
const takenCourseIds = new Set(listTakenCourseIds());
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Degree planner — course catalogue</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Dashboard</a>
      <a href="/courses/">Courses</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Course catalogue</h1>
      <p>
        Every course in the Master of Computing, for entering history from
        outside the current semester's recommendations — for example a course
        completed in a previous degree, or before you started using this
        planner.
      </p>
      <table>
        <thead>
          <tr>
            <th scope="col">Code</th>
            <th scope="col">Title</th>
            <th scope="col">Units</th>
            <th scope="col">Completed</th>
          </tr>
        </thead>
        <tbody>
          {
            courses.map((course) => {
              const taken = takenCourseIds.has(course.id);
              return (
                <tr>
                  <td>{course.code}</td>
                  <td>{course.title}</td>
                  <td>{course.units}</td>
                  <td>
                    <form method="post" action="/api/taken">
                      <input type="hidden" name="courseId" value={course.id} />
                      <input type="hidden" name="back" value="/courses/" />
                      <input type="hidden" name="action" value={taken ? "remove" : "add"} />
                      <button>{taken ? "Mark not completed" : "Mark completed"}</button>
                    </form>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </main>
  </body>
</html>
