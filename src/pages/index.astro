---
import {
  getCurrentSemester,
  getStudentSpecialisationId,
  listCourses,
  listIncompatibilities,
  listOfferedCourseIds,
  listPrerequisites,
  listRequirements,
  listSemesters,
  listSpecialisations,
  listTakenBeforeCourseIds,
  listTakenCourseIds,
} from "../lib/db";
import { planFor } from "../lib/recommend";
import Layout from "../layouts/Layout.astro";

const semester = getCurrentSemester();
const semesters = listSemesters();
const specialisations = listSpecialisations();
const specialisationId = getStudentSpecialisationId();
const takenCourseIds = listTakenCourseIds();
const courses = listCourses();
const courseById = new Map(courses.map((c) => [c.id, c]));

const currentSpecialisation = specialisations.find((s) => s.id === specialisationId);

const plan = planFor({
  specialisationId,
  specialisationElectiveUnitsRequired: currentSpecialisation?.electiveUnitsRequired ?? 0,
  takenCourseIds,
  takenBeforeThisSemesterCourseIds: listTakenBeforeCourseIds(semester.id),
  offeredCourseIds: listOfferedCourseIds(semester.id),
  requirements: listRequirements(specialisationId),
  prerequisites: listPrerequisites(),
  incompatibilities: listIncompatibilities(),
  courses,
});
const takenCourses = takenCourseIds
  .map((id) => courseById.get(id))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);
const nextSemester = semesters[semesters.findIndex((s) => s.id === semester.id) + 1];
const progressPct = Math.min(100, Math.round((plan.unitsDone / plan.unitsRequired) * 100));
---

<Layout title="Degree planner — dashboard" active="dashboard">
  <h1>Master of Computing (7706XMCOMP)</h1>
  <p>Your personal study plan, based on your specialisation and completed courses.</p>

  <section aria-label="current status" class="quick-facts">
    <p>
      <strong>{semester.label}</strong> · specialising in <strong>{currentSpecialisation?.name}</strong>
    </p>
    <p>{plan.unitsDone} / {plan.unitsRequired} required units completed</p>
    <div class="quick-facts__progress"><span style={`width: ${progressPct}%`} /></div>

    <form method="post" action="/api/specialisation" class="status-form">
      <label for="specialisationId">Switch specialisation</label>
      <select id="specialisationId" name="specialisationId">
        {
          specialisations.map((s) => (
            <option value={s.id} selected={s.id === specialisationId}>
              {s.name}
            </option>
          ))
        }
      </select>
      <button>Switch</button>

      {
        nextSemester && (
          <button formaction="/api/semester">Advance to {nextSemester.label}</button>
        )
      }
    </form>
  </section>

      <section aria-label="recommended courses">
        <h2>Take this semester</h2>
        {
          plan.takeThisSemester.length === 0 ? (
            <p>Nothing required is available to take right now.</p>
          ) : (
            <ul class="course-list">
              {plan.takeThisSemester.map((course) => (
                <li>
                  <span><span class="course-list__code">{course.code}</span>{course.title}</span>
                  <form method="post" action="/api/taken">
                    <input type="hidden" name="courseId" value={course.id} />
                    <input type="hidden" name="back" value="/" />
                    <button>Mark complete</button>
                  </form>
                </li>
              ))}
            </ul>
          )
        }

        {
          plan.notYetAvailable.length > 0 && (
            <>
              <h2>Not yet available</h2>
              <ul class="course-list">
                {plan.notYetAvailable.map(({ course, reasons }) => (
                  <li>
                    <span>
                      <span class="course-list__code">{course.code}</span>{course.title}
                    </span>
                    <span class="blocking-reasons">{reasons.join("; ")}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </section>

      {
        plan.electivePools.map((pool) => (
          <section aria-label={pool.label}>
            <h2>{pool.label}</h2>
            <p>{pool.unitsDone} / {pool.unitsRequired} units</p>
            {
              pool.available.length === 0 ? (
                <p>Nothing from this list is available to take right now.</p>
              ) : (
                <ul class="course-list">
                  {pool.available.map((course) => (
                    <li>
                      <span><span class="course-list__code">{course.code}</span>{course.title}</span>
                      <form method="post" action="/api/taken">
                        <input type="hidden" name="courseId" value={course.id} />
                        <input type="hidden" name="back" value="/" />
                        <button>Mark complete</button>
                      </form>
                    </li>
                  ))}
                </ul>
              )
            }
            {
              pool.notYetAvailable.length > 0 && (
                <details>
                  <summary>Not yet available ({pool.notYetAvailable.length})</summary>
                  <ul class="course-list">
                    {pool.notYetAvailable.map(({ course, reasons }) => (
                      <li>
                        <span>
                          <span class="course-list__code">{course.code}</span>{course.title}
                        </span>
                        <span class="blocking-reasons">{reasons.join("; ")}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )
            }
          </section>
        ))
      }

      <section aria-label="completed courses">
        <h2>Completed so far</h2>
        {
          takenCourses.length === 0 ? (
            <p>Nothing completed yet.</p>
          ) : (
            <ul class="course-list">
              {takenCourses.map((course) => (
                <li><span class="course-list__code">{course.code}</span>{course.title}</li>
              ))}
            </ul>
          )
        }
      </section>
</Layout>
